# Copy to .env and replace every placeholder before starting the backend.
# The backend intentionally rejects the short placeholder tokens below.
ASGUARD_PORT=8080
ASGUARD_HOST=localhost
ASGUARD_RUNTIME=astrid
ASGUARD_AUDIT_KEY=replace-me-audit-key
ASGUARD_API_CREDENTIALS=[{"id":"runtime-local","token":"replace-me-runtime-token","roles":["runtime"]},{"id":"admin-local","token":"replace-me-admin-token","roles":["admin","operator","auditor"]}]