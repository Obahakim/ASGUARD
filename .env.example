#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';

const repoRoot = path.resolve(path.dirname(new URL(import.meta.url).href.replace('file://', '')), '..');
const pkgPath = path.join(repoRoot, 'package.json');
const gitignorePath = path.join(repoRoot, '.gitignore');
const envExamplePath = path.join(repoRoot, '.env.example');

function ensurePkgDeps() {
  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
  pkg.dependencies = {
    ...pkg.dependencies,
    '@unicitylabs/sphere-sdk': '^0.11.15',
    'drizzle-orm': '^0.45.2',
    'pg': '^8.23.0',
  };
  delete pkg.dependencies['react-simple-maps'];

  pkg.devDependencies = {
    ...pkg.devDependencies,
    '@types/pg': '^8.23.1',
  };

  fs.writeFileSync(pkgPath, `${JSON.stringify(pkg, null, 2)}\n`);
}

function ensureGitignore() {
  const content = fs.readFileSync(gitignorePath, 'utf8');
  const additions = [
    '',
    '# local wallet and runtime artifacts',
    '.sphere-data/',
    '.sphere-tokens/',
    '.astrid/',
    '',
    '# generated local audit and policy data',
    '/asguard_audit_*.json',
    '/audit_chain.json',
    '/asguard_policy.json',
  ];

  if (!content.includes('.sphere-data/')) {
    fs.writeFileSync(gitignorePath, `${content.trimEnd()}\n${additions.join('\n')}\n`);
  }
}

function ensureEnvExample() {
  const contents = `# Unicity / AgentSphere runtime configuration
UNICITY_NETWORK=testnet2
UNICITY_WALLET_API_URL=https://wallet-api.unicity.network
UNICITY_DEVICE_ID=asguard-runtime
# No Oracle API key is required; AgentSphere authenticates with wallet signatures.
UNICITY_DATA_DIR=./.sphere-data
UNICITY_TOKENS_DIR=./.sphere-tokens

# ASGUARD control-plane defaults
ASGUARD_HOST=127.0.0.1
ASGUARD_PORT=8080
ASGUARD_DEMO_MODE=false
ASGUARD_ALLOWED_ORIGINS=http://localhost:3000
ASGUARD_AUDIT_KEY=

# Neon persistence (required for durable pilot records)
DATABASE_URL=
`;

  if (!fs.existsSync(envExamplePath)) {
    fs.writeFileSync(envExamplePath, contents);
  }
}

ensurePkgDeps();
ensureGitignore();
ensureEnvExample();
console.log('Merge resolution script applied to the repo root.');
