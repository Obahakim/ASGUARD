# Copy to .env. Generate independent random values for each token and the audit key:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# The API tokens below are placeholders; the backend rejects tokens shorter than 32 bytes.

# Backend/API authentication (required)
ASGUARD_API_CREDENTIALS=[{"id":"runtime-local","token":"REPLACE_WITH_RANDOM_RUNTIME_TOKEN","roles":["runtime"]},{"id":"dashboard-local","token":"REPLACE_WITH_DIFFERENT_DASHBOARD_TOKEN","roles":["admin","operator","auditor"]}]
ASGUARD_AUDIT_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
ASGUARD_AUDIT_CHAIN_PATH=

# Ed25519 approval attestations: private key is server-only; distribute only the public key to hosts.
ASGUARD_ATTESTATION_PRIVATE_KEY_PATH=.asguard/attestation-private.pem
ASGUARD_ATTESTATION_PUBLIC_KEY_PATH=.asguard/attestation-public.pem

# Optional NEAR AI enrichment. Use an HTTPS endpoint under near.ai; policy remains authoritative.
ASGUARD_AI_ENABLED=false
ASGUARD_AI_API_URL=
ASGUARD_AI_API_KEY=
ASGUARD_AI_MODEL=

# Optional host-only testnet transfer demo. The backend strips the private key before server startup.
ASGUARD_DEMO_SUBMIT=false
ASGUARD_DEMO_NEAR_ACCOUNT_ID=
ASGUARD_DEMO_NEAR_PRIVATE_KEY=
ASGUARD_DEMO_NEAR_RECIPIENT=
ASGUARD_DEMO_NEAR_AMOUNT=0.001
# Optional Tidepool community testnet demo. Setup leaves settlement/faucet off by default.
# The demo key is host-only and stripped from the backend process at startup. Never commit .env.
# Mainnet must use official 1Click and intents.near; never use a mainnet key for demos.
ASGUARD_DEMO_TIDEPOOL_SETTLE=false
ASGUARD_DEMO_TIDEPOOL_FAUCET=false
ASGUARD_DEMO_TIDEPOOL_ACCOUNT_ID=
ASGUARD_DEMO_TIDEPOOL_PRIVATE_KEY=

# Backend and dashboard URLs
ASGUARD_HOST=localhost
ASGUARD_PORT=8080
ASGUARD_RUNTIME=asguard
ASGUARD_ALLOWED_ORIGINS=http://localhost:3000
# REST API base URL used by the host SDK and demos.
ASGUARD_API_URL=http://localhost:8080
# Optional runtime token override for local demo scripts; otherwise they select a runtime token above.
ASGUARD_DEMO_TOKEN=
# Optional when dashboard and API are not on the same host/default port.
NEXT_PUBLIC_ASGUARD_API_URL=

# NEAR is the default target. Intents approvals do not sign or submit transactions.
ASGUARD_NEAR_NETWORK=testnet
ASGUARD_NEAR_RPC_URL=https://rpc.testnet.near.org
ASGUARD_NEAR_INTENTS_API_URL=https://www.usetidepool.tech
ASGUARD_NEAR_INTENTS_VERIFIER=verifier.tidepool-sandbox.testnet
# For mainnet, set ASGUARD_NEAR_NETWORK=mainnet and switch to https://1click.chaindefuser.com + intents.near.
ASGUARD_NEAR_CHAIN_SIGNATURES_CONTRACT=v1.signer-prod.testnet

# Approval and local intent ledger
ASGUARD_APPROVAL_TTL_MS=120000
# Empty uses ~/.asguard/transaction_intents.json.
ASGUARD_TRANSACTION_INTENTS_PATH=
# Empty uses ~/.asguard/agent_profiles.json.
ASGUARD_AGENT_PROFILES_PATH=

# Read-only NEAR account watcher
ASGUARD_WATCHED_WALLETS_PATH=
ASGUARD_WALLET_WATCH_INTERVAL_MS=20000

# Optional external alerts. ASGUARD sends these only for HITL-blocked requests.
TELEGRAM_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ASGUARD_GENERIC_WEBHOOK_URL=

# Optional wallet-watch demo account (public account ID only)
ASGUARD_WATCH_DEMO_ACCOUNT=
