# Unicity / AgentSphere runtime configuration. Mainnet wallet creation needs a
# mainnet gateway key from the Unicity network operator and a wallet password.
UNICITY_NETWORK=mainnet
UNICITY_WALLET_API_URL=https://wallet-api.mainnet.unicity.network
UNICITY_GATEWAY_URL=https://gateway.mainnet.unicity.network
UNICITY_DEVICE_ID=asguard-runtime
UNICITY_ORACLE_API_KEY=
UNICITY_WALLET_PASSWORD=
UNICITY_DATA_DIR=./.sphere-mainnet-data

# ASGUARD control-plane defaults
ASGUARD_HOST=
ASGUARD_PORT=
ASGUARD_DEMO_MODE=false
ASGUARD_ALLOWED_ORIGINS=http://localhost:3000
ASGUARD_AUDIT_KEY=
ASGUARD_API_CREDENTIALS=[{"id":"runtime-local","token":"replace-with-runtime-secret","roles":["runtime"]},{"id":"admin-local","token":"replace-with-admin-secret","roles":["admin","operator","auditor"]}]

# Neon persistence (required for durable pilot records)
DATABASE_URL=
