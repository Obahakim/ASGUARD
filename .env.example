# Copy to .env. Generate a different random value for each token and the audit key:
# PowerShell: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
# The API tokens below are placeholders; the backend rejects tokens shorter than 32 bytes.

# Backend/API authentication (required)
ASGUARD_API_CREDENTIALS=[{"id":"runtime-local","token":"REPLACE_WITH_RANDOM_RUNTIME_TOKEN","roles":["runtime"]},{"id":"dashboard-local","token":"REPLACE_WITH_DIFFERENT_DASHBOARD_TOKEN","roles":["admin","operator","auditor"]}]
ASGUARD_AUDIT_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# Legacy signing-key fallback; normally leave empty and use ASGUARD_AUDIT_KEY.
ASGUARD_APPROVAL_KEY=

# Backend and dashboard URLs
ASGUARD_HOST=localhost
ASGUARD_PORT=8080
ASGUARD_RUNTIME=astrid
ASGUARD_ALLOWED_ORIGINS=http://localhost:3000
# Optional when dashboard and API are not on the same host/default port.
NEXT_PUBLIC_ASGUARD_API_URL=

# NEAR is the default target. Intents approvals do not sign or submit transactions.
ASGUARD_NEAR_NETWORK=testnet
ASGUARD_NEAR_RPC_URL=https://rpc.testnet.near.org
ASGUARD_NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
ASGUARD_NEAR_INTENTS_VERIFIER=intents.near
ASGUARD_NEAR_CHAIN_SIGNATURES_CONTRACT=v1.signer-prod.testnet

# Approval and local intent ledger
ASGUARD_APPROVAL_TTL_MS=120000
# Empty uses ~/.astrid/transaction_intents.json.
ASGUARD_TRANSACTION_INTENTS_PATH=
# Empty uses ~/.astrid/agent_profiles.json.
ASGUARD_AGENT_PROFILES_PATH=

# Optional legacy adapter. Disabled unless explicitly enabled.
ASGUARD_ENABLE_SOLANA_ADAPTER=false
ASGUARD_SOLANA_CLUSTER=devnet
ASGUARD_SOLANA_RPC_URL=https://api.devnet.solana.com
ASGUARD_SOLANA_ALLOW_CUSTOM_RPC=false

# Optional external alerts. ASGUARD sends these only for HITL-blocked requests.
TELEGRAM_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ASGUARD_GENERIC_WEBHOOK_URL=

# Optional Neon/Postgres persistence. Local intent and audit storage still work without it.
DATABASE_URL=

# Optional Unicity/AgentSphere integration settings
UNICITY_NETWORK=testnet2
UNICITY_WALLET_API_URL=https://wallet-api.unicity.network
UNICITY_GATEWAY_URL=https://gateway.testnet2.unicity.network
UNICITY_DEVICE_ID=asguard-runtime
UNICITY_ORACLE_API_KEY=
UNICITY_WALLET_PASSWORD=
UNICITY_DATA_DIR=./.sphere-data

# Optional paper-trader demo overrides
ASGUARD_MCP_URL=http://localhost:8080/mcp
ASGUARD_DEMO_TOKEN=
ASGUARD_DEMO_AGENT_ID=demo-paper-trader
