{
  "name": "asguard",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./agent-sdk": {
      "types": "./agent-sdk/index.ts",
      "import": "./agent-sdk/index.ts"
    }
  },
  "scripts": {
    "dev": "concurrently \"next dev\" \"node --env-file=.env --import tsx --watch server/index.ts\"",
    "dev:frontend": "next dev",
    "dev:backend": "node --env-file=.env --import tsx --watch server/index.ts",
    "build": "npm run build:server && npm run build:agent-sdk && npm run build:frontend:types && next build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "build:agent-sdk": "tsc --noEmit -p tsconfig.agent-sdk.json",
    "build:frontend:types": "tsc --noEmit -p tsconfig.frontend.json",
    "test": "node --require ./scripts/test-preload.cjs --import tsx --test --test-force-exit server/**/*.test.ts agent-sdk/**/*.test.ts",
    "demo:near": "node --env-file=.env --import tsx scripts/demo-near.ts approve",
    "demo:near:approve": "node --env-file=.env --import tsx scripts/demo-near.ts approve",
    "demo:near:hitl": "node --env-file=.env --import tsx scripts/demo-near.ts hitl",
    "demo:near:block": "node --env-file=.env --import tsx scripts/demo-near.ts block",
    "demo:agent-guard": "node --env-file=.env --import tsx scripts/demo-agent-guard.ts",
    "demo:watch": "node --env-file=.env --import tsx scripts/demo-watch.ts",
    "lint": "eslint .",
    "start": "next start",
    "backend:start": "node --env-file=.env --import tsx server/index.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "@types/topojson-client": "^3.1.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "^3.1.1",
    "express": "^4.18.2",
    "framer-motion": "^12.23.25",
    "jiti": "latest",
    "lucide-react": "0.555.0",
    "next": "16.0.6",
    "ws": "^8.14.2",
    "prop-types": "latest",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/ws": "^8.5.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/d3-geo": "^3.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "postcss": "8.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
