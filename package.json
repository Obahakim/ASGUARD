{
  "name": "asguard",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/sdk"
  ],
  "exports": {
    "./agent-sdk": {
      "types": "./dist/sdk/agent-sdk/index.d.ts",
      "default": "./dist/sdk/agent-sdk/index.js"
    }
  },
  "scripts": {
    "dev": "concurrently \"next dev\" \"node --import tsx scripts/watch-backend.ts\"",
    "dev:frontend": "next dev",
    "dev:backend": "node --import tsx scripts/watch-backend.ts",
    "build": "npm run build:server && npm run build:agent-sdk && npm run build:cli && npm run build:frontend:types && next build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "build:agent-sdk": "tsc --noEmit -p tsconfig.agent-sdk.json",
    "build:sdk": "tsc -p tsconfig.agent-sdk.build.json",
    "build:cli": "tsc --noEmit -p tsconfig.cli.json",
    "build:frontend:types": "tsc --noEmit -p tsconfig.frontend.json",
    "test": "node scripts/test.mjs",
    "demo:near": "node scripts/run-demo.cjs scripts/demo-near.ts approve",
    "demo:near:approve": "node scripts/run-demo.cjs scripts/demo-near.ts approve",
    "demo:near:hitl": "node scripts/run-demo.cjs scripts/demo-near.ts hitl",
    "demo:near:block": "node scripts/run-demo.cjs scripts/demo-near.ts block",
    "demo:suite": "node scripts/run-demo.cjs scripts/demo-suite.ts",
    "demo:agent-guard": "node scripts/run-demo.cjs scripts/demo-agent-guard.ts",
    "demo:watch": "node scripts/run-demo.cjs scripts/demo-watch.ts",
    "demo:near:approve:submit": "node scripts/run-demo.cjs scripts/demo-near-approve-submit.ts",
    "demo:near:tidepool:approve": "node scripts/run-demo.cjs scripts/demo-near-tidepool.ts approve",
    "demo:near:tidepool:tamper": "node scripts/run-demo.cjs scripts/demo-near-tidepool.ts tamper",
    "demo:onchain": "node scripts/run-demo.cjs scripts/demo-near-tidepool.ts onchain",
    "setup": "node --import tsx cli/setup.ts",
    "stop": "node --import tsx cli/stop.ts",
    "connect": "node --import tsx cli/connect.ts",
    "lint": "eslint .",
    "start": "next start",
    "backend:start": "node --env-file=.env --import tsx scripts/start-backend.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^4.18.2",
    "framer-motion": "^12.23.25",
    "jiti": "latest",
    "lucide-react": "0.555.0",
    "near-api-js": "^7.4.0",
    "next": "16.0.6",
    "ws": "^8.14.2",
    "prop-types": "latest",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/ws": "^8.5.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "postcss": "8.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
