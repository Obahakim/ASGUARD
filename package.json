{
  "name": "black-friday-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "concurrently \"next dev\" \"tsx watch server/index.ts\"",
    "dev:frontend": "next dev",
